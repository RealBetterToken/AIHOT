# VibeHot 统一模型配置。复制成 .env.models，只填写下面两家的 API Key。
# 不要提交 .env.models；本机建议 chmod 600 .env.models。
# 本机 API、worker 自动读取，已有环境变量优先。Docker 仅 API、worker 读取此文件。
# 自定义 OpenAI 兼容地址可替换 Base URL，需提供相同的模型名称和对应协议。
# 安全阀只放在主 .env：此文件不能开启采集、模型、飞书或 IndexNow。

# ===== 两家服务商 =====
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=

# ===== 每个处理环节 =====
PREFILTER_MODEL=qwen3.7-flash
SCORE_MODEL=deepseek-flash
UNDERSTAND_MODEL=deepseek-flash
SUMMARIZE_MODEL=deepseek-flash
STRUCTURE_MODEL=qwen3.7-flash
GROUP_MODEL=deepseek-flash
GROUP_REVIEW_MODEL=deepseek-flash
DIGEST_MODEL=deepseek-flash
REPORT_MODEL=deepseek-flash
TRANSLATE_MODEL=qwen-mt-flash
LOCALIZE_MODEL=qwen-mt-flash
# 千问初译后对照原文审校；同样受主 .env 的模型安全阀和付费预算约束。
TRANSLATION_REVIEW_ENABLED=true
TRANSLATION_REVIEW_MODEL=deepseek-flash
# 监控模块默认关闭；这里仅预设它开启以后使用的型号。
MONITOR_MODEL=deepseek-flash

# 填完文件只代表配置就绪，不代表已验证模型效果或已启用付费调用。
# 开启主 .env 中的 MODEL_CALLS_ENABLED 前，按 docs/model-configuration.md 对照检查三语样本。
